# Voxly Frontend Environment Variables
# Copy this file to .env and replace with your actual values

# Authentication Service URL
VITE_AUTH_URL=https://huggingface.co/spaces/Yaya5777/voxly-auth

# TTS Service URL  
VITE_TTS_URL=https://huggingface.co/spaces/Yaya5777/voxly-tts

# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID

# Frontend Public URL (for OAuth redirects)
VITE_PUBLIC_URL=https://frontend-voxly.vercel.app

# Optional: Development URLs (uncomment for local development)
# VITE_AUTH_URL=http://localhost:8000
# VITE_TTS_URL=http://localhost:8001
# VITE_PUBLIC_URL=http://localhost:5173
